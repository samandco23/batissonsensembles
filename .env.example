# ---------------------------------------------------------------------------
# Base de données (Neon)
# DATABASE_URL  → endpoint "pooler" (runtime)
# DIRECT_URL    → endpoint direct, sans "-pooler" (migrations / db push)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth admin (compte unique défini ici, aucun compte en base)
# Générer le hash : npm run hash -- 'MonMotDePasse'
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@batissonsensemble.tech"
ADMIN_PASSWORD_HASH="$2a$10$remplacer_par_le_hash_bcrypt"
NEXTAUTH_SECRET="openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Fapshi — Mobile Money (MTN MoMo + Orange Money)
# Sandbox : https://sandbox.fapshi.com   |   Live : https://live.fapshi.com
# Le secret webhook se configure aussi dans le dashboard Fapshi.
# ---------------------------------------------------------------------------
FAPSHI_API_USER=""
FAPSHI_API_KEY=""
FAPSHI_BASE_URL="https://sandbox.fapshi.com"
FAPSHI_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Date et heure du tirage (ISO 8601, fuseau Afrique/Douala = +01:00)
NEXT_PUBLIC_DRAW_DATE="2027-03-31T18:00:00+01:00"

NEXT_PUBLIC_CONTACT_EMAIL="contact@batissonsensemble.tech"
